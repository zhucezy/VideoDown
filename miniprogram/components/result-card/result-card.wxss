.rc {
  padding: 28rpx;
  margin-top: 24rpx;
  animation: rise 0.32s cubic-bezier(0.22, 0.68, 0.35, 1);
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

/* ===== 顶部标签 ===== */
.rc-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.rc-plat {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.rc-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(18, 183, 106, 0.1);
  color: #12b76a;
  font-size: 22rpx;
  font-weight: 600;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #12b76a;
}

.rc-spacer {
  flex: 1;
}

.rc-time {
  font-size: 22rpx;
  color: #9aa0a6;
}

.cover-count {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 20rpx;
}

/* ===== 预览 ===== */
.rc-preview {
  display: flex;
  gap: 22rpx;
}

.rc-cover {
  position: relative;
  width: 216rpx;
  height: 288rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eef0f3;
  flex-shrink: 0;
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0) 40%,
    rgba(0, 0, 0, 0.24) 100%
  );
}

.play-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
}

.play-tri {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-left: 20rpx solid #16181d;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
}

.cover-res {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 20rpx;
}

.rc-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.rc-title {
  font-size: 28rpx;
  line-height: 1.5;
  color: #16181d;
  font-weight: 500;
}

.rc-author {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #5b6270;
}

.avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #eef0f3;
  flex-shrink: 0;
}

.rc-stats {
  margin-top: auto;
  font-size: 22rpx;
  color: #9aa0a6;
}

/* ===== 清晰度 ===== */
.rc-qua {
  margin-top: 26rpx;
}

.qua-label {
  font-size: 24rpx;
  color: #5b6270;
  margin-bottom: 14rpx;
}

.qua-scroll {
  width: 100%;
  white-space: nowrap;
}

.qua-list {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.qua-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 150rpx;
  padding: 14rpx 22rpx;
  border-radius: 14rpx;
  background: #f5f6f8;
  border: 2rpx solid transparent;
  transition: all 0.16s;
}

.qua-item.active {
  background: rgba(43, 109, 246, 0.08);
  border-color: #2b6df6;
}

.qua-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #16181d;
}

.qua-item.active .qua-name {
  color: #2b6df6;
}

.qua-size {
  font-size: 20rpx;
  color: #9aa0a6;
  margin-top: 2rpx;
}

.qua-best {
  position: absolute;
  top: -10rpx;
  right: -8rpx;
  padding: 0 10rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 14rpx 14rpx 14rpx 0;
  background: linear-gradient(135deg, #ff8a3d, #f5483b);
  color: #fff;
  font-size: 18rpx;
  transform: scale(0.9);
}

/* ===== 进度条 ===== */
.rc-progress {
  margin-top: 26rpx;
}

.pg-bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: #eef0f3;
  overflow: hidden;
}

.pg-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #3d7bff, #2b6df6);
  transition: width 0.2s;
}

.pg-text {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 10rpx;
}

/* ===== 图片网格（可勾选） ===== */
.rc-imgs {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #edeff2;
}

.img-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.img-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #16181d;
}

.img-selall {
  font-size: 24rpx;
  color: #2b6df6;
  padding: 6rpx 4rpx;
}

.img-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.img-cell {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 14rpx;
  overflow: hidden;
  background: #eef0f3;
  border: 4rpx solid transparent;
  transition: border-color 0.16s, transform 0.16s;
}

.img-cell.on {
  border-color: #2b6df6;
}

.img-cell:active {
  transform: scale(0.97);
}

.img-thumb {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.img-check {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.32);
  border: 3rpx solid rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  line-height: 1;
}

.img-check.on {
  background: #2b6df6;
  border-color: #2b6df6;
}

.img-idx {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 0 10rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 18rpx;
}

.img-save {
  width: 100%;
  margin-top: 22rpx;
}

/* ===== 操作区 ===== */
.rc-actions {
  margin-top: 28rpx;
}

.rc-save {
  width: 100%;
}

.rc-sub-actions {
  display: flex;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #edeff2;
}

.sa-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #5b6270;
}

.sa-item:active {
  opacity: 0.6;
}

.sa-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #f5f6f8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #2b6df6;
  font-weight: 600;
}
