<view class="rc card" wx:if="{{data}}">
  <!-- 顶部：平台标签 + 内容类型徽标 -->
  <view class="rc-top">
    <view class="rc-plat" style="background:{{platColor}};">{{data.platformName}}</view>
    <view class="rc-badge">
      <text class="dot"></text>
      <text>{{contentType === 'image' ? '无压缩原图' : '无水印'}}</text>
    </view>
    <view class="rc-spacer"></view>
    <view class="rc-time">{{data.durationText || (hasImages && !hasVideo ? imageCount + ' 张' : '')}}</view>
  </view>

  <!-- 预览区 -->
  <view class="rc-preview">
    <view class="rc-cover" bindtap="onCoverTap" data-index="0">
      <image
        class="cover-img"
        src="{{data.cover}}"
        mode="aspectFill"
        lazy-load
        binderror="onCoverError"
      />
      <view class="cover-mask" wx:if="{{hasVideo}}">
        <view class="play-btn">
          <view class="play-tri"></view>
        </view>
      </view>
      <view class="cover-res" wx:if="{{hasVideo && currentQuality.label}}">{{currentQuality.label}}</view>
      <view class="cover-count" wx:if="{{hasImages && !hasVideo}}">{{imageCount}} 张</view>
    </view>

    <view class="rc-meta">
      <view class="rc-title ellipsis-2">{{data.title || '未获取到标题'}}</view>
      <view class="rc-author" wx:if="{{data.author}}">
        <image class="avatar" wx:if="{{data.authorAvatar}}" src="{{data.authorAvatar}}" mode="aspectFill" />
        <text class="ellipsis-1">{{data.author}}</text>
      </view>
      <view class="rc-stats">
        <text wx:if="{{currentQuality.sizeText}}">{{currentQuality.sizeText}}</text>
        <text wx:if="{{currentQuality.sizeText && hasImages}}"> · </text>
        <text wx:if="{{hasImages}}">{{imageCount}} 张图片</text>
        <text wx:if="{{!currentQuality.sizeText && !hasImages}}">支持最高分辨率</text>
      </view>
    </view>
  </view>

  <!-- 清晰度选择：默认选中最高（仅视频内容） -->
  <view class="rc-qua" wx:if="{{hasVideo && data.qualities.length > 1}}">
    <view class="qua-label">清晰度</view>
    <scroll-view class="qua-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="qua-list">
        <view
          class="qua-item {{index === qualityIndex ? 'active' : ''}}"
          wx:for="{{data.qualities}}"
          wx:key="url"
          data-index="{{index}}"
          bindtap="onSelectQuality"
        >
          <text class="qua-name">{{item.label}}</text>
          <text class="qua-size" wx:if="{{item.sizeText}}">{{item.sizeText}}</text>
          <view class="qua-best" wx:if="{{index === 0}}">最高</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ===== 图片网格（图集 / 纯图片页，可勾选下载） ===== -->
  <view class="rc-imgs" wx:if="{{hasImages}}">
    <view class="img-head">
      <text class="img-title">图片（共 {{imageCount}} 张）</text>
      <view class="img-selall" bindtap="onToggleAll">
        {{selectedCount === imageCount ? '取消全选' : '全选'}}
      </view>
    </view>

    <view class="img-grid">
      <view
        class="img-cell {{selectedImages[index] ? 'on' : ''}}"
        wx:for="{{data.images}}"
        wx:key="url"
        data-index="{{index}}"
        bindtap="onToggleImage"
      >
        <image
          class="img-thumb"
          src="{{item.url}}"
          mode="aspectFill"
          lazy-load
        />
        <view class="img-check {{selectedImages[index] ? 'on' : ''}}">
          <text wx:if="{{selectedImages[index]}}">✓</text>
        </view>
        <view class="img-idx">{{index + 1}}</view>
      </view>
    </view>

    <button
      class="btn btn-primary img-save"
      disabled="{{imgSaving || selectedCount === 0}}"
      loading="{{imgSaving}}"
      bindtap="onSaveImages"
    >
      {{imgSaving ? '保存中 ' + imgProgressText : (selectedCount ? '保存选中图片(' + selectedCount + ')' : '请选择图片')}}
    </button>
  </view>

  <!-- 下载进度（视频） -->
  <view class="rc-progress" wx:if="{{downloading}}">
    <view class="pg-bar">
      <view class="pg-fill" style="width:{{percent}}%;"></view>
    </view>
    <view class="pg-text">
      <text>{{progressText}}</text>
      <text>{{percent}}%</text>
    </view>
  </view>

  <!-- 主操作 -->
  <view class="rc-actions">
    <button
      class="btn btn-primary rc-save"
      disabled="{{downloading || imgSaving}}"
      bindtap="onSavePrimary"
    >
      {{primaryLabel}}
    </button>
  </view>

  <!-- 次级操作 -->
  <view class="rc-sub-actions">
    <view class="sa-item" wx:if="{{data.cover}}" bindtap="onSaveCover">
      <view class="sa-icon">图</view>
      <text>存封面</text>
    </view>
    <view class="sa-item" bindtap="onCopyTitle">
      <view class="sa-icon">文</view>
      <text>复制文案</text>
    </view>
    <view class="sa-item" bindtap="onCopyUrl">
      <view class="sa-icon">链</view>
      <text>复制直链</text>
    </view>
  </view>
</view>
