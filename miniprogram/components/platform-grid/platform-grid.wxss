.pg {
  padding: 32rpx 28rpx 12rpx;
}

.pg-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 26rpx;
}

.pg-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #16181d;
}

.pg-sub {
  font-size: 22rpx;
  color: #9aa0a6;
}

.pg-list {
  display: flex;
  flex-wrap: wrap;
}

.pg-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.pg-item:active .pg-logo {
  transform: scale(0.92);
}

.pg-logo {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  transition: transform 0.15s;
  box-shadow: 0 6rpx 16rpx rgba(22, 24, 29, 0.1);
}

.pg-name {
  font-size: 22rpx;
  color: #5b6270;
}
