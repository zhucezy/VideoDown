.ad-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 20rpx;
  background: #fff;
  /* 关键：不写死高度，交由 <ad> 内容撑开 */
  transition: height 0.22s ease, opacity 0.22s ease, margin 0.22s ease;
}

.ad-wrap.is-hidden {
  height: 0 !important;
  opacity: 0;
  margin: 0;
  pointer-events: none;
}

.ad-inner {
  width: 100%;
  overflow: hidden;
  border-radius: 20rpx;
}

.ad-inner ad {
  display: block;
  width: 100%;
}

/* 加载中的等比骨架，按常见 banner 比例给一个温和占位 */
.ad-skeleton {
  width: 100%;
  height: 160rpx;
  border-radius: 20rpx;
}

.ad-wrap.is-loaded .ad-skeleton {
  display: none;
}

/* 开发期占位 */
.ad-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 160rpx;
  border: 2rpx dashed #d8dce3;
  border-radius: 20rpx;
  background: #fafbfc;
}

.ph-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #eef2fb;
  color: #2b6df6;
  font-size: 22rpx;
  font-weight: 600;
}

.ph-text {
  font-size: 22rpx;
  color: #9aa0a6;
  padding: 0 40rpx;
  text-align: center;
}

.ad-close {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.32);
  color: #fff;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
}
