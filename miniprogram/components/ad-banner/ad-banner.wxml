<!--
  自适应广告位
  - 外层容器不设固定高度，完全由 <ad> 组件内容撑开，广告素材多高容器就多高
  - 加载中显示等高骨架，避免内容跳动
  - 加载失败 / 无广告填充时整块塌陷为 0，不留白
-->
<view
  class="ad-wrap {{status === 'loaded' ? 'is-loaded' : ''}} {{status === 'error' ? 'is-hidden' : ''}}"
  style="{{ status === 'loaded' ? 'height:' + boxHeight : '' }}"
>
  <!-- 骨架占位：仅在首次加载时出现 -->
  <view wx:if="{{status === 'loading'}}" class="ad-skeleton skeleton"></view>

  <view wx:if="{{unitId}}" class="ad-inner" id="adInner">
    <ad
      unit-id="{{unitId}}"
      ad-type="banner"
      ad-theme="white"
      ad-intervals="{{interval}}"
      bindload="onAdLoad"
      binderror="onAdError"
      bindclose="onAdClose"
    ></ad>
  </view>

  <!-- 未配置 unit-id 时的占位（开发期可视化，发布前配置好即可自动消失） -->
  <view wx:else class="ad-placeholder" bindtap="onPlaceholderTap">
    <view class="ph-badge">广告位</view>
    <view class="ph-text">在 utils/config.js 填入 bannerUnitId 后自动展示</view>
  </view>

  <view wx:if="{{status === 'loaded' && closable}}" class="ad-close" catchtap="onManualClose">
    <text>×</text>
  </view>
</view>
