page {
  /* ===== 设计变量 ===== */
  --brand: #2b6df6;
  --brand-dark: #1c56d6;
  --brand-soft: rgba(43, 109, 246, 0.08);
  --bg: #f4f5f7;
  --card: #ffffff;
  --text-1: #16181d;
  --text-2: #5b6270;
  --text-3: #9aa0a6;
  --line: #edeff2;
  --danger: #f5483b;
  --success: #12b76a;
  --radius-lg: 24rpx;
  --radius-md: 16rpx;
  --radius-sm: 10rpx;
  --shadow: 0 8rpx 28rpx rgba(22, 24, 29, 0.06);

  background: var(--bg);
  color: var(--text-1);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue',
    Helvetica, Segoe UI, Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
input,
textarea,
button,
image {
  box-sizing: border-box;
}

/* ===== 通用容器 ===== */
.page {
  min-height: 100vh;
  background: var(--bg);
}

.container {
  padding: 0 24rpx;
}

.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.safe-bottom {
  height: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* ===== 文本 ===== */
.t-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}

.t-sub {
  font-size: 24rpx;
  color: var(--text-3);
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ellipsis-1 {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== 按钮 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: opacity 0.15s, transform 0.15s;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #3d7bff 0%, #2b6df6 100%);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(43, 109, 246, 0.28);
}

.btn-ghost {
  background: var(--brand-soft);
  color: var(--brand);
}

.btn-plain {
  background: #f2f3f5;
  color: var(--text-2);
}

.btn:active {
  opacity: 0.86;
  transform: scale(0.985);
}

.btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* ===== 骨架屏 ===== */
.skeleton {
  background: linear-gradient(90deg, #eef0f3 25%, #f6f7f9 37%, #eef0f3 63%);
  background-size: 400% 100%;
  animation: sk 1.2s ease infinite;
  border-radius: var(--radius-sm);
}

@keyframes sk {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
