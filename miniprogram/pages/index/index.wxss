.page {
  position: relative;
  height: 100vh;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(180deg, #e6eeff 0%, rgba(244, 245, 247, 0) 100%);
  pointer-events: none;
}

.scroll {
  position: relative;
  height: 100vh;
  box-sizing: border-box;
}

/* ===== 广告位 ===== */
.ad-slot {
  padding: 8rpx 24rpx 0;
}

/* ===== 输入卡片 ===== */
.container {
  padding: 24rpx 24rpx 0;
}

.input-card {
  padding: 32rpx 28rpx 28rpx;
}

.ic-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.ic-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #16181d;
}

.ic-tip {
  font-size: 24rpx;
  color: #2b6df6;
  padding: 4rpx 0 4rpx 20rpx;
}

.ic-box {
  position: relative;
  min-height: 168rpx;
  padding: 24rpx 60rpx 24rpx 24rpx;
  border-radius: 18rpx;
  background: #f5f6f8;
  border: 2rpx solid transparent;
  transition: all 0.18s;
}

.ic-box.focused {
  background: #fff;
  border-color: #2b6df6;
  box-shadow: 0 0 0 6rpx rgba(43, 109, 246, 0.08);
}

.ic-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #16181d;
}

.ph {
  color: #b4b9c2;
  font-size: 27rpx;
}

.ic-clear {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #d8dce3;
  color: #fff;
  font-size: 28rpx;
  line-height: 38rpx;
  text-align: center;
}

.ic-detect {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  animation: fadeIn 0.25s;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateX(-10rpx);
  }
  to {
    opacity: 1;
  }
}

.dt-logo {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dt-text {
  font-size: 24rpx;
  color: #12b76a;
}

.ic-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.ic-paste {
  width: 180rpx;
  flex-shrink: 0;
}

.ic-parse {
  flex: 1;
}

.ic-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #9aa0a6;
  text-align: center;
}

/* ===== 骨架 ===== */
.sk-card {
  padding: 28rpx;
}

.sk-row {
  display: flex;
  gap: 22rpx;
}

.sk-cover {
  width: 216rpx;
  height: 288rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.sk-lines {
  flex: 1;
  padding-top: 8rpx;
}

.sk-line {
  height: 28rpx;
  margin-bottom: 20rpx;
}

.w90 {
  width: 90%;
}
.w70 {
  width: 70%;
}
.w40 {
  width: 40%;
}

.sk-btn {
  height: 88rpx;
  border-radius: 44rpx;
  margin-top: 28rpx;
}

/* ===== 错误卡片 ===== */
.err-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  margin-top: 24rpx;
}

.err-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(245, 72, 59, 0.1);
  color: #f5483b;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.err-body {
  flex: 1;
  min-width: 0;
}

.err-title {
  font-size: 28rpx;
  color: #16181d;
  font-weight: 500;
}

.err-tip {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 6rpx;
}

.err-retry {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(43, 109, 246, 0.08);
  color: #2b6df6;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* ===== 步骤 ===== */
.steps {
  padding: 32rpx 28rpx 12rpx;
}

.st-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 26rpx;
}

.st-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 26rpx;
}

.st-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(43, 109, 246, 0.08);
  color: #2b6df6;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.st-h {
  font-size: 28rpx;
  color: #16181d;
  font-weight: 500;
}

.st-p {
  font-size: 24rpx;
  color: #9aa0a6;
  margin-top: 4rpx;
  line-height: 1.5;
}

/* ===== 最近解析 ===== */
.recent {
  padding: 28rpx;
}

.rc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.rc-h {
  font-size: 30rpx;
  font-weight: 600;
}

.rc-more {
  font-size: 24rpx;
  color: #9aa0a6;
}

.rc-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
}

.rc-item:active {
  opacity: 0.6;
}

.rc-thumb {
  width: 96rpx;
  height: 128rpx;
  border-radius: 12rpx;
  background: #eef0f3;
  flex-shrink: 0;
}

.rc-info {
  flex: 1;
  min-width: 0;
}

.rc-t {
  font-size: 27rpx;
  color: #16181d;
}

.rc-m {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}

.rc-arrow {
  color: #c8ccd3;
  font-size: 34rpx;
}

/* ===== 页脚 ===== */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 48rpx 40rpx 24rpx;
  font-size: 21rpx;
  color: #b4b9c2;
  text-align: center;
}
