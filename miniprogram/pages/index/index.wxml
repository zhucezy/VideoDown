<view class="page">
  <!-- 顶部渐变背景 -->
  <view class="hero-bg"></view>

  <nav-bar title="视频解析" bg="transparent" color="#16181D" />

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- ===== 1. 顶部广告位（高度随广告素材自适应，无填充时自动收起） ===== -->
    <view class="ad-slot">
      <ad-banner bindadstate="onAdState" />
    </view>

    <!-- ===== 2. 输入卡片 ===== -->
    <view class="container">
      <view class="input-card card">
        <view class="ic-head">
          <text class="ic-title">粘贴视频链接</text>
          <view class="ic-tip" bindtap="onShowHelp">
            <text>怎么获取？</text>
          </view>
        </view>

        <view class="ic-box {{focus ? 'focused' : ''}}">
          <textarea
            class="ic-input"
            value="{{input}}"
            placeholder="支持直接粘贴整段分享文案，自动提取链接"
            placeholder-class="ph"
            maxlength="1000"
            auto-height
            show-confirm-bar="{{false}}"
            adjust-position="{{true}}"
            cursor-spacing="24"
            disable-default-padding="{{true}}"
            bindinput="onInput"
            bindfocus="onFocus"
            bindblur="onBlur"
          ></textarea>

          <view wx:if="{{input}}" class="ic-clear" catchtap="onClear">
            <text>×</text>
          </view>
        </view>

        <!-- 识别到的平台提示 -->
        <view class="ic-detect" wx:if="{{detected}}">
          <view class="dt-logo" style="background:{{detected.color}};">{{detected.letter}}</view>
          <text class="dt-text">已识别：{{detected.name}}</text>
        </view>

        <view class="ic-actions">
          <button class="btn btn-plain ic-paste" bindtap="onPaste">
            <text>粘贴</text>
          </button>
          <button
            class="btn btn-primary ic-parse"
            loading="{{parsing}}"
            disabled="{{parsing || !input}}"
            bindtap="onParse"
          >
            {{parsing ? '解析中…' : '立即解析'}}
          </button>
        </view>

        <view class="ic-note">
          <text>解析后可选择最高分辨率保存，去除平台水印</text>
        </view>
      </view>
    </view>

    <!-- ===== 3. 解析中骨架 ===== -->
    <view class="container" wx:if="{{parsing}}">
      <view class="card sk-card">
        <view class="sk-row">
          <view class="skeleton sk-cover"></view>
          <view class="sk-lines">
            <view class="skeleton sk-line w90"></view>
            <view class="skeleton sk-line w70"></view>
            <view class="skeleton sk-line w40"></view>
          </view>
        </view>
        <view class="skeleton sk-btn"></view>
      </view>
    </view>

    <!-- ===== 4. 解析结果 ===== -->
    <view class="container" wx:if="{{result && !parsing}}">
      <result-card
        data="{{result}}"
        bindsaved="onSaved"
        bindpreview="onPreview"
      />
    </view>

    <!-- ===== 5. 错误提示 ===== -->
    <view class="container" wx:if="{{errorMsg && !parsing}}">
      <view class="err-card card">
        <view class="err-icon">!</view>
        <view class="err-body">
          <view class="err-title">{{errorMsg}}</view>
          <view class="err-tip">{{errorTip}}</view>
        </view>
        <view class="err-retry" bindtap="onParse">重试</view>
      </view>
    </view>

    <!-- ===== 6. 支持平台 ===== -->
    <view class="container">
      <view class="card">
        <platform-grid max="12" />
      </view>
    </view>

    <!-- ===== 7. 使用步骤 ===== -->
    <view class="container">
      <view class="card steps">
        <view class="st-title">三步搞定</view>
        <view class="st-item" wx:for="{{steps}}" wx:key="idx">
          <view class="st-num">{{index + 1}}</view>
          <view class="st-body">
            <view class="st-h">{{item.h}}</view>
            <view class="st-p">{{item.p}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 8. 最近解析 ===== -->
    <view class="container" wx:if="{{recent.length}}">
      <view class="card recent">
        <view class="rc-head">
          <text class="rc-h">最近解析</text>
          <text class="rc-more" bindtap="goHistory">全部 ›</text>
        </view>
        <view
          class="rc-item"
          wx:for="{{recent}}"
          wx:key="videoId"
          data-index="{{index}}"
          bindtap="onRecentTap"
        >
          <image class="rc-thumb" src="{{item.cover}}" mode="aspectFill" lazy-load />
          <view class="rc-info">
            <view class="rc-t ellipsis-1">{{item.title || '未命名视频'}}</view>
            <view class="rc-m">{{item.platformName}} · {{item.timeText}}</view>
          </view>
          <view class="rc-arrow">›</view>
        </view>
      </view>
    </view>

    <view class="footer">
      <text>本工具仅供个人学习与素材备份使用</text>
      <text>请尊重原作者版权，勿用于商业传播</text>
    </view>

    <view class="safe-bottom"></view>
  </scroll-view>
</view>
