.page {
  height: 100vh;
  overflow: hidden;
  background: #f4f5f7;
}

.scroll {
  height: 100vh;
}

.ad-slot {
  padding: 8rpx 24rpx 0;
}

.container {
  padding: 24rpx 24rpx 0;
}

/* ===== 统计 ===== */
.stat {
  display: flex;
  align-items: center;
  padding: 36rpx 0;
}

.st-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.st-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #16181d;
  line-height: 1.1;
}

.st-label {
  font-size: 22rpx;
  color: #9aa0a6;
}

.st-split {
  width: 2rpx;
  height: 48rpx;
  background: #edeff2;
}

/* ===== 菜单 ===== */
.menu {
  padding: 8rpx 28rpx;
}

.mi {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #edeff2;
}

.mi:last-child {
  border-bottom: none;
}

.mi:active {
  opacity: 0.6;
}

.mi-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.mi-body {
  flex: 1;
  min-width: 0;
}

.mi-title {
  font-size: 29rpx;
  color: #16181d;
  font-weight: 500;
}

.mi-desc {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 4rpx;
}

.mi-arrow {
  font-size: 36rpx;
  color: #c8ccd3;
}

/* ===== FAQ ===== */
.faq {
  padding: 32rpx 28rpx 12rpx;
}

.fq-h {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.fq-item {
  padding: 22rpx 0;
  border-bottom: 2rpx solid #edeff2;
}

.fq-item:last-child {
  border-bottom: none;
}

.fq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.fq-qt {
  font-size: 27rpx;
  color: #16181d;
  flex: 1;
}

.fq-ic {
  font-size: 32rpx;
  color: #c8ccd3;
  transform: rotate(90deg);
  transition: transform 0.2s;
}

.fq-ic.open {
  transform: rotate(-90deg);
}

.fq-a {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #f8f9fb;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5b6270;
}

/* ===== 须知 ===== */
.notice {
  padding: 32rpx 28rpx;
}

.nt-h {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.nt-p {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.nt-dot {
  color: #c8ccd3;
  line-height: 1.7;
}

.nt-t {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5b6270;
}

.version {
  text-align: center;
  font-size: 22rpx;
  color: #b4b9c2;
  padding: 40rpx 0 20rpx;
}
