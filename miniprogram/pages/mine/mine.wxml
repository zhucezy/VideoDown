<view class="page">
  <nav-bar title="我的" bg="#F4F5F7" />

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="ad-slot">
      <ad-banner />
    </view>

    <!-- 数据概览 -->
    <view class="container">
      <view class="card stat">
        <view class="st-cell">
          <view class="st-num">{{stat.total}}</view>
          <view class="st-label">累计解析</view>
        </view>
        <view class="st-split"></view>
        <view class="st-cell">
          <view class="st-num">{{stat.platforms}}</view>
          <view class="st-label">覆盖平台</view>
        </view>
        <view class="st-split"></view>
        <view class="st-cell">
          <view class="st-num">{{stat.today}}</view>
          <view class="st-label">今日解析</view>
        </view>
      </view>
    </view>

    <!-- 功能列表 -->
    <view class="container">
      <view class="card menu">
        <view class="mi" wx:for="{{menus}}" wx:key="key" data-key="{{item.key}}" bindtap="onMenu">
          <view class="mi-icon" style="background:{{item.bg}};color:{{item.color}};">{{item.icon}}</view>
          <view class="mi-body">
            <view class="mi-title">{{item.title}}</view>
            <view class="mi-desc">{{item.desc}}</view>
          </view>
          <view class="mi-arrow">›</view>
        </view>
      </view>
    </view>

    <!-- 常见问题 -->
    <view class="container">
      <view class="card faq">
        <view class="fq-h">常见问题</view>
        <view class="fq-item" wx:for="{{faqs}}" wx:key="q" data-index="{{index}}" bindtap="toggleFaq">
          <view class="fq-q">
            <text class="fq-qt">{{item.q}}</text>
            <text class="fq-ic {{item.open ? 'open' : ''}}">›</text>
          </view>
          <view class="fq-a" wx:if="{{item.open}}">{{item.a}}</view>
        </view>
      </view>
    </view>

    <!-- 免责声明 -->
    <view class="container">
      <view class="card notice">
        <view class="nt-h">使用须知</view>
        <view class="nt-p" wx:for="{{notices}}" wx:key="*this">
          <text class="nt-dot">•</text>
          <text class="nt-t">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="version">版本 {{version}}</view>
    <view class="safe-bottom"></view>
  </scroll-view>
</view>
