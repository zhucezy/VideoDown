.page {
  height: 100vh;
  overflow: hidden;
  background: #f4f5f7;
}

.scroll {
  height: 100vh;
}

.ad-slot {
  padding: 8rpx 24rpx 0;
}

.container {
  padding: 24rpx;
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 18rpx;
}

.bar-count {
  font-size: 24rpx;
  color: #9aa0a6;
}

.bar-clear {
  font-size: 24rpx;
  color: #f5483b;
  padding: 6rpx 16rpx;
}

.list {
  padding: 8rpx 28rpx;
}

.item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #edeff2;
}

.item:last-child {
  border-bottom: none;
}

.it-main {
  display: flex;
  gap: 20rpx;
}

.it-main:active {
  opacity: 0.65;
}

.it-thumb {
  width: 112rpx;
  height: 150rpx;
  border-radius: 14rpx;
  background: #eef0f3;
  flex-shrink: 0;
}

.it-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.it-title {
  font-size: 28rpx;
  line-height: 1.5;
  color: #16181d;
}

.it-meta {
  margin-top: auto;
  font-size: 22rpx;
  color: #9aa0a6;
}

.it-plat {
  font-weight: 600;
}

.it-type {
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(43, 109, 246, 0.08);
  font-size: 20rpx;
}

.it-dot {
  margin: 0 8rpx;
}

.it-ops {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 18rpx;
}

.op {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #f5f6f8;
  color: #5b6270;
  font-size: 23rpx;
}

.op:active {
  opacity: 0.6;
}

.op-danger {
  background: rgba(245, 72, 59, 0.08);
  color: #f5483b;
}

/* ===== 空态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.em-illu {
  width: 200rpx;
  height: 200rpx;
  border-radius: 40rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(22, 24, 29, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-bottom: 36rpx;
}

.em-box {
  width: 76rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: #e6eeff;
}

.em-line {
  width: 96rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #eef0f3;
}

.em-line.short {
  width: 62rpx;
}

.em-title {
  font-size: 30rpx;
  color: #16181d;
  font-weight: 500;
}

.em-sub {
  font-size: 24rpx;
  color: #9aa0a6;
  margin-top: 10rpx;
}

.em-btn {
  width: 280rpx;
  margin-top: 48rpx;
}
