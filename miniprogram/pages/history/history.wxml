<view class="page">
  <nav-bar title="解析记录" bg="#F4F5F7" />

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 顶部广告位 -->
    <view class="ad-slot">
      <ad-banner />
    </view>

    <view wx:if="{{list.length}}" class="container">
      <view class="bar">
        <text class="bar-count">共 {{list.length}} 条</text>
        <text class="bar-clear" bindtap="onClear">清空</text>
      </view>

      <view class="card list">
        <view class="item" wx:for="{{list}}" wx:key="videoId">
          <view class="it-main" data-index="{{index}}" bindtap="onReparse">
            <image class="it-thumb" src="{{item.cover}}" mode="aspectFill" lazy-load />
            <view class="it-info">
              <view class="it-title ellipsis-2">{{item.title || '未命名视频'}}</view>
              <view class="it-meta">
                <text class="it-type" style="color:{{item.platColor}};">{{item.typeLabel}}</text>
                <text class="it-plat" style="color:{{item.platColor}};">{{item.platformName}}</text>
                <text class="it-dot">·</text>
                <text>{{item.timeText}}</text>
                <text wx:if="{{item.bestLabel}}" class="it-dot">·</text>
                <text wx:if="{{item.bestLabel}}">{{item.bestLabel}}</text>
                <text wx:if="{{item.imgCount}}" class="it-dot">·</text>
                <text wx:if="{{item.imgCount}}">{{item.imgCount}}图</text>
              </view>
            </view>
          </view>
          <view class="it-ops">
            <view class="op" data-index="{{index}}" catchtap="onCopy">复制链接</view>
            <view class="op op-danger" data-index="{{index}}" catchtap="onRemove">删除</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空态 -->
    <view wx:else class="empty">
      <view class="em-illu">
        <view class="em-box"></view>
        <view class="em-line"></view>
        <view class="em-line short"></view>
      </view>
      <view class="em-title">还没有解析记录</view>
      <view class="em-sub">去首页粘贴一条视频链接试试</view>
      <button class="btn btn-primary em-btn" bindtap="goIndex">去解析</button>
    </view>

    <view class="safe-bottom"></view>
  </scroll-view>
</view>
