# ============================================================
# VideoDown 仓库根 .gitignore（对子目录递归生效）
# ============================================================

# ---------- Node / 服务端 ----------
node_modules/
.pnp/
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- 环境变量 / 密钥（绝不可提交） ----------
.env
.env.local
.env.*.local
*.local

# ---------- 日志 ----------
*.log

# ---------- 内部记忆（WorkBuddy 私有，不对外） ----------
.workbuddy/

# ---------- Flutter / Dart ----------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
flutter_*.png
coverage/

# ---------- Android ----------
.gradle/
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/key.properties
**/android/**/GeneratedPluginRegistrant.java
*.keystore
*.jks
*.apk
*.aab
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
.externalNativeBuild/
.cxx/

# ---------- iOS（若将来补） ----------
**/ios/Flutter/Flutter.framework/
**/ios/Flutter/Generated.xcconfig
**/ios/Runner/GeneratedPluginRegistrant.*

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.iml
.project
.settings/

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- 临时 / 缓存 ----------
*.tmp
.cache/
