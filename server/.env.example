# 服务端口
PORT=3000

# 对外访问地址，必须与小程序里配置的 request / downloadFile 合法域名一致
PUBLIC_BASE=https://api.yourdomain.com

# 代理直链签名密钥（务必改成随机长字符串，例如 openssl rand -hex 32）
SIGN_SECRET=please-change-me-to-a-random-64-char-string

# 代理链接有效期（秒）
SIGN_TTL=7200

# 小程序凭据（用于静默登录换 openid，可留空走匿名模式）
WX_APPID=
WX_SECRET=

# 每 IP 每分钟解析次数上限
RATE_MAX=20

# 抓取超时（毫秒）
FETCH_TIMEOUT=12000

# 各平台登录 Cookie（可选，配置后成功率显著提升）
# 快手、小红书风控较严，强烈建议配置
COOKIE_DOUYIN=
COOKIE_KUAISHOU=
COOKIE_XHS=
COOKIE_BILI=
COOKIE_WEIBO=
